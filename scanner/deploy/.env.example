# Copy to .env on the server and fill in. Never commit the filled-in file.

# cTrader Open API app (https://openapi.ctrader.com/apps → Credentials → View)
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
# Account number shown in cTrader (top bar), e.g. the demo account
CTRADER_ACCOUNT_ID=
# Must also be listed under the app's "Redirect URLs" if you authorise from the server's dashboard
CTRADER_REDIRECT_URI=https://scanner.example.com/oauth/callback

# Dashboard login (HTTP Basic) — required when the dashboard is reachable from the internet
ICTSCAN_USER=admin
ICTSCAN_PASSWORD=

# Read-only key for the chart add-ons (cTrader indicator / MT5 expert in addons/) that download /api/feed/<symbol>.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(24))"
ICTSCAN_FEED_TOKEN=

# Port mapping (see docker-compose.yml)
BIND=127.0.0.1
HOST_PORT=8083
